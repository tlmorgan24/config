{
  // Shared defaults; each language can override these settings.
  "defaults": {
    "enabled": true,
    "width": 100,
    "tabWidth": 4, // VS Code settings.json takes priority, so no need to repeat language-specific overrides in this file
    "minColWidth": 30
  },
  // Add a VS Code language ID with the formatter to use.
  // If another extension sets the default formatter, override with "editor.defaultFormatter": "tlmorgan24.comment-wrap"
  // in that language's VS Code settings.json block (e.g. "[go]").
  "languages": {
    "go": {
      "formatter": "go-comment-wrap",
      "args": [
        "--base-formatter=gofmt"
      ]
    },
    "shellscript": {
      "formatter": "shell-comment-wrap"
    },
    "python": {
      "formatter": "python-comment-wrap"
    },
    "javascript": {
      "formatter": "js-comment-wrap"
    },
    "javascriptreact": {
      "formatter": "js-comment-wrap"
    },
    "typescript": {
      "formatter": "js-comment-wrap"
    },
    "typescriptreact": {
      "formatter": "js-comment-wrap"
    },
    "json": {
      "formatter": "js-comment-wrap"
    },
    "jsonc": {
      "formatter": "js-comment-wrap"
    }
  }
}
