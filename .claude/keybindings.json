{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "cmd+e": "chat:externalEditor",
        "ctrl+r": "command:resume",
        "cmd+enter": "chat:queueSubmit"
      }
    },
    {
      "context": "Global",
      "bindings": {
        "alt+up": "app:toggleDiffNoiseFilter",
        "alt+down": "app:toggleDiffPreSession",
        "alt+escape": "app:toggleReplTab",
        "cmd+x": "app:cycleDiffBase",
        "cmd+c": "strip:jump9",
        "cmd+up": "strip:jump1",
        "cmd+down": "strip:jump2",
        "cmd+shift+up": "strip:jump5",
        "cmd+shift+down": "strip:jump6",
        "ctrl+up": "strip:jump3",
        "ctrl+down": "strip:jump4"
      }
    }
  ]
}
