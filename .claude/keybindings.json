{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "cmd+e": "chat:externalEditor",
        "ctrl+r": "command:resume",
        "cmd+enter": "chat:queueSubmit"
      }
    },
    {
      "context": "Global",
      "bindings": {
        "alt+up": "app:toggleDiffNoiseFilter",
        "alt+down": "app:toggleDiffPreSession",
        "alt+c": "app:toggleReplTab"
      }
    }
  ]
}
