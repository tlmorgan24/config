// Can be opened in VS Code via Preferences: Open Keyboard Shortcuts (JSON).
[
  // Keybindings for terminal shortcuts whose key sequences are intercepted by VS Code
  {
    "key": "cmd+shift+left",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b[1;10D"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+shift+right",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b[1;10C"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;9A" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;9B" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+shift+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;10A" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+shift+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;10B" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[13;9u" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+e",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[101;9u" },
    "when": "terminalFocus"
  },

  {
    // Intention: copy command-line program's current selection to clipboard (would use cmd+c, but VS Code already uses
    // this to copy its OWN selection, e.g. following mouse drag).
    "key": "cmd+shift+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      // cmd+shift+c would technically be 10u (9u is for cmd+c), but I still expect programs to expect cmd+c, hence use
      // of 9u here.
      "text": "\u001b[99;9u"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+x",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b[120;9u"
    },
    "when": "terminalFocus"
  },

  {
    "key": "cmd+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001f"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+shift+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b/"
    },
    "when": "terminalFocus"
  },

  {
    "key": "cmd+]",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[93;9u" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+[",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[91;9u" },
    "when": "terminalFocus"
  },

  // Jump to the previous/next command's prompt, e.g. to get back past a long output (VS Code's defaults for this,
  // cmd+up/down, are used above). Needs macOS's own ctrl+up/down turned off, which copy.sh does. Full-screen programs
  // (on the alternate buffer, which has no shell prompts) get the keys instead, e.g. for Claude Code to jump between my
  // prompts (see the prompt-jump mod).
  {
    "key": "ctrl+up",
    "command": "workbench.action.terminal.scrollToPreviousCommand",
    "when": "terminalFocus && !terminalAltBufferActive"
  },
  {
    "key": "ctrl+down",
    "command": "workbench.action.terminal.scrollToNextCommand",
    "when": "terminalFocus && !terminalAltBufferActive"
  }
]
