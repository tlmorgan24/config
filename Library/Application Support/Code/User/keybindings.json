// Can be opened in VS Code via Preferences: Open Keyboard Shortcuts (JSON).
[
  // Keybindings for terminal shortcuts whose key sequences are intercepted by VS Code
  {
    "key": "cmd+shift+left",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b[1;10D"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+shift+right",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b[1;10C"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;9A" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;9B" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+shift+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;10A" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+shift+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;10B" },
    "when": "terminalFocus"
  },
  // VS Code's defaults turn option+up/down into ctrl+up/down (`\u001b[1;5A`/`B`), so send them as themselves, matching
  // Ghostty (e.g. for Claude Code's held-message editing and the rebase tool).
  {
    "key": "alt+up",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;3A" },
    "when": "terminalFocus"
  },
  {
    "key": "alt+down",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[1;3B" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[13;9u" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+e",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[101;9u" },
    "when": "terminalFocus"
  },
  {
    // Save and quit, in Vim (see .vimrc). Outside the terminal, cmd+s still saves the editor's file.
    "key": "cmd+s",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[115;9u" },
    "when": "terminalFocus"
  },

  {
    // Intention: copy command-line program's current selection to clipboard (would use cmd+c, but VS Code already uses
    // this to copy its OWN selection, e.g. following mouse drag).
    "key": "cmd+shift+c",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      // cmd+shift+c would technically be 10u (9u is for cmd+c), but I still expect programs to expect cmd+c, hence use
      // of 9u here.
      "text": "\u001b[99;9u"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+x",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b[120;9u"
    },
    "when": "terminalFocus"
  },

  {
    "key": "cmd+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001f"
    },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+shift+z",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b/"
    },
    "when": "terminalFocus"
  },

  {
    "key": "cmd+]",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[93;9u" },
    "when": "terminalFocus"
  },
  {
    "key": "cmd+[",
    "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u001b[91;9u" },
    "when": "terminalFocus"
  },

  // Jump to the previous/next command's prompt, e.g. to get back past a long output (VS Code's defaults for this,
  // cmd+up/down, are used above). Needs macOS's own ctrl+up/down turned off, which copy.sh does. Full-screen programs
  // (on the alternate buffer, which has no shell prompts) get the keys instead, e.g. for Claude Code to jump between my
  // prompts (see the prompt-jump mod).
  {
    "key": "ctrl+up",
    "command": "workbench.action.terminal.scrollToPreviousCommand",
    "when": "terminalFocus && !terminalAltBufferActive"
  },
  {
    "key": "ctrl+down",
    "command": "workbench.action.terminal.scrollToNextCommand",
    "when": "terminalFocus && !terminalAltBufferActive"
  },

  // Copy a reference to the file, with cmd+alt+c giving its path relative to the workspace folder and shift+cmd+alt+c
  // its absolute path. In the editor text, the selected lines are added, e.g. `src/main.go:12-18`, using my
  // copy-reference extension (see vscode-copy-reference/ in the config repo). Elsewhere (e.g. the explorer or search
  // results), just the path of the selected file(s), or of the active editor's file. In the editor, cmd+k then
  // cmd+alt+c/shift+cmd+alt+c copies just the path.
  //
  // VS Code's defaults are the other way round (cmd+alt+c absolute, shift+cmd+alt+c relative), so remove them. Relative
  // is on the simpler key, as it's shorter, readable in docs, and works in Claude Code sessions and terminals in the
  // repo.
  //
  // In the editor text, this replaces VS Code's cmd+alt+c for toggling the find widget's case sensitivity, but that
  // still works while typing in the find widget. The debug watch view and the built-in browser keep their own
  // cmd+alt+c.
  {
    "key": "cmd+alt+c",
    "command": "-copyFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "shift+cmd+alt+c",
    "command": "-copyRelativeFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "cmd+k cmd+alt+c",
    "command": "-copyFilePath",
    "when": "editorFocus"
  },
  {
    "key": "cmd+k shift+cmd+alt+c",
    "command": "-copyRelativeFilePath",
    "when": "editorFocus"
  },
  {
    "key": "cmd+alt+c",
    "command": "copyReference.copy",
    "when": "editorTextFocus"
  },
  {
    "key": "shift+cmd+alt+c",
    "command": "copyReference.copy",
    "args": { "absolute": true },
    "when": "editorTextFocus"
  },
  {
    "key": "cmd+alt+c",
    "command": "copyRelativeFilePath",
    "when": "!editorFocus && focusedView != 'workbench.debug.watchExpressionsView' && activeEditor != 'workbench.editor.browser'"
  },
  {
    "key": "shift+cmd+alt+c",
    "command": "copyFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "cmd+k cmd+alt+c",
    "command": "copyRelativeFilePath",
    "when": "editorFocus"
  },
  {
    "key": "cmd+k shift+cmd+alt+c",
    "command": "copyFilePath",
    "when": "editorFocus"
  },

  // Use cmd+0 to reset zoom, matching what macOS generally uses
  {
  "key": "cmd+0",
  "command": "workbench.action.zoomReset"
  },

  // Change the keybindings for moving between recent cursor locations.
  {
    "key": "ctrl+-",
    "command": "-workbench.action.navigateBack"
  },
  {
    "key": "ctrl+shift+-",
    "command": "-workbench.action.navigateForward"
  },
  {
    "key": "cmd+alt+left",
    "command": "workbench.action.navigateBack"
  },
  {
    "key": "cmd+alt+right",
    "command": "workbench.action.navigateForward"
  }
]
