// can be opened in VS Code via Preferences: Open Settings (JSON)
{
  // ### THEME ###
  // install with "Catppuccin for VS Code" extension: https://marketplace.visualstudio.com/items?itemName=Catppuccin.catppuccin-vsc
  "workbench.colorTheme": "Catppuccin Mocha", // good base, from which I override selected parts below
  // install with "Catppuccin Icons for VS Code" extension: https://marketplace.visualstudio.com/items?itemName=Catppuccin.catppuccin-vsc-icons
  "workbench.iconTheme": "catppuccin-mocha", // file icons
  // override editor syntax highlighting
  "editor.tokenColorCustomizations": {
    "[Catppuccin Mocha]": {
      "textMateRules": [
        {
          "scope": [ // methods and functions
            "entity.name.function",
            "meta.function-call.generic.python", // in Python, function calls considered different scope to function declarations
            "support.function"
          ],
          "settings": {
            "fontStyle": "" // non-italicised, instead of theme's default (italicised)
          }
        },
        {
          // operators, in all languages: sky (as in Catppuccin's style guide, and Vim's Catppuccin theme), instead of theme's teal.
          // These are all the theme's teal scopes that are operators (teal is otherwise the guide's colour for enum members)
          "scope": [
            "keyword.operator", // the scopes from here to punctuation.separator.key-value are the theme's "Punctuation" group
            "punctuation.accessor",
            "punctuation.definition.generic",
            "meta.function.closure punctuation.section.parameters",
            "punctuation.definition.tag",
            "punctuation.separator.key-value",
            "keyword.operator.quantifier.regexp",
            "keyword.declaration.function.arrow.js",
            "storage.type.function.arrow.ts",
            "storage.modifier.reference.cpp",
            "punctuation.separator.operator.css",
            "storage.type.operator.haskell",
            "storage.type.operator.infix.haskell",
            "entity.name.function.infix.haskell",
            "punctuation.backtick.haskell"
          ],
          "settings": {
            "foreground": "#89dceb"
          }
        },

        // shell scripts: to match my Zsh command-line highlighting (~/.zsh/syntax-highlighting.zsh) and Vim
        {
          "scope": [ // && and & (|| and | are keyword.operators already)
            "punctuation.separator.statement.and.shell",
            "punctuation.separator.statement.background.shell"
          ],
          "settings": {
            "foreground": "#89dceb" // sky (operators)
          }
        },
        {
          "scope": "support.function.builtin.shell", // echo, cd etc
          "settings": {
            "foreground": "#89b4fa" // blue, like other commands, instead of theme's red (builtins)
          }
        },
        {
          "scope": [ // unquoted arguments, e.g. foo and out.txt in `cat foo > out.txt`
            "string.unquoted.argument.shell",
            "string.unquoted.shell"
          ],
          "settings": {
            "foreground": "#cdd6f4" // text, instead of green (strings), so only quoted strings are green
          }
        },
        {
          "scope": "source.shell constant.other.option", // -la, --color=auto etc
          "settings": {
            "foreground": "#fab387" // peach, instead of the green it otherwise gets from being in an argument
          }
        },
        {
          // $var, ${var}, $? etc. Positional parameters ($1, ${1}, $@) keep the theme's maroon italic (parameters)
          "scope": [
            "variable.other.normal.shell",
            "string.quoted.double.shell variable.other.normal.shell", // overrides the theme's rule (text) for $var inside "..."
            "variable.language.special.shell",
            "punctuation.definition.variable.shell",
            "source.shell meta.parameter-expansion"
          ],
          "settings": {
            "foreground": "#f5e0dc" // rosewater (the guide's colour for macros, which like variables get replaced before running)
          }
        },
        {
          "scope": [ // * ? etc
            "variable.language.special.wildcard.shell",
            "keyword.operator.glob.shell"
          ],
          "settings": {
            "foreground": "#f5c2e7" // pink (the guide's colour for patterns), instead of text and sky (operators)
          }
        },
        {
          "scope": "string.interpolated.process-substitution.shell", // <(command)
          "settings": {
            "foreground": "#cdd6f4" // text (the commands inside get their own colours), instead of green (strings)
          }
        },
        {
          "scope": [ // the ` ` around `command`, and the <( ) around <(command)
            "punctuation.definition.evaluation.backticks.shell",
            "source.shell punctuation.section.interpolation",
            "string.interpolated.process-substitution.shell punctuation.definition.string"
          ],
          "settings": {
            "foreground": "#9399b2" // overlay 2 (delimiters), like the $( ) around $(command), instead of teal and green
          }
        }
      ]
    }
  },

  // Go: semantic highlighting from the language server, rather than simple regex-based textmate, so that e.g.
  // parameters stay maroon italic inside the function body, not just in the declaration (as Pylance does for Python)
  "gopls": {
    "ui.semanticTokens": true,
    // leave strings and numbers to textmate, which keeps escapes (\n) pink, and runes ('x') green rather than peach
    "ui.semanticTokenTypes": { "string": false, "number": false }
  },

  // override colours other than editor syntax
  // some borders and backgrounds are mauve ("#cba6f7") in theme default, which I find can stick out too much
  "workbench.colorCustomizations": {
    "button.background": "#45475a", // default: "#cba6f7"
    "button.hoverBackground": "#585b70", // default: "#dec7fa"
    "button.border": "#00000000", // default: "#00000000" (hack for "no border")
    "button.foreground": "#cdd6f4", // default: "11111b"
    "button.secondaryBackground": "#45475a", // default: "#585b70"
    "button.secondaryHoverBackground": "#585b70", // default: "#686b84" 
    "button.secondaryBorder": "#00000000", // default: "#cba6f7"
    "button.secondaryForeground": "#cdd6f4", // default: "#cdd6f4"

    "badge.background": "#45475a", // default: "#45475a"
    "badge.foreground": "#cdd6f4", // default: "#cdd6f4"
    "activityBarBadge.background": "#45475a", // default: "#cba6f7"
    "activityBarBadge.foreground": "#cdd6f4", // default: "#11111b"

    "extensionButton.background": "#45475a", // default: "#585b70"
    "extensionButton.hoverBackground": "#585b70", // default: "#686b84" 
    "extensionButton.border": "#00000000", // default: "#cba6f7"
    "extensionButton.foreground": "#cdd6f4", // default: "#cdd6f4"
    "extensionButton.prominentBackground": "#cba6f7", // default: "#cba6f7"
    "extensionButton.prominentHoverBackground": "#dec7fa", // default: "#dec7fa"
    "extensionButton.prominentForeground": "#11111b", // default: "#11111b"
    // no 'extensionButton.prominentBorder' setting exists, so forced to have same border for regular
    // extension buttons as for prominent ones

    "notifications.border": "#6c7086", // default: "#cba6f7"
    "notificationToast.border": "#6c7086", // default: "#cba6f7"
    "notificationCenter.border": "#6c7086", // default: "#cba6f7"
    "notifications.background": "#1e1e2e", // default: "#181825"
    "notificationCenterHeader.background": "#1e1e2e", // default: "#181825"

    "focusBorder": "#9399b2" // default: "#cba6f7"
  },

  // ### FONT ###
  // install with: brew install --cask font-jetbrains-mono-nerd-font
  "editor.fontFamily": "'JetBrainsMono Nerd Font'", // fontname with whitespace has to be single-quoted
  "editor.fontLigatures": true, // e.g. '>' followed by '=' formats as '≥'
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'", // fontname with whitespace has to be single-quoted
  // alternative - install with: brew install --cask font-fira-code-nerd-font
  /*
  "editor.fontFamily": "'FiraCode Nerd Font'", // fontname with whitespace has to be single-quoted
  "editor.fontLigatures": true, // e.g. '>' followed by '=' formats as '≥'
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font'", // fontname with whitespace has to be single-quoted
  */
  "window.zoomLevel": 0.5,
  "editor.fontSize": 13,
  "editor.letterSpacing": 0,
  "editor.smoothScrolling": true,

  // ### INSERT SPACES WHEN PRESS TAB ###
  "editor.insertSpaces": true,
  // Exceptions for languages which prefer tabs over spaces:
  "[go]": {
    "editor.insertSpaces": false
  },
  "[makefile]": {
    "editor.insertSpaces": false // already VS Code's default, but listed for completeness
  },

  // ### TAB SIZING ###
  "editor.tabSize": 4, // default (overrides to 2 specified below)
  "[shellscript]": { // eg bash (see files.associations)
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": { // json with comments (this settings.json file is actually JSONC, hence why I can comment!)
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.tabSize": 2
  },
  "[xml]": {
    "editor.tabSize": 2
  },
  "[graphql]": {
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.tabSize": 2
  },

  "files.associations": {
    "*.sh": "shellscript",
    "*.bash": "shellscript",
    "*.zsh": "shellscript",

    ".zshrc": "shellscript",
    ".zshenv": "shellscript",
    ".zprofile": "shellscript",
    ".zlogin": "shellscript",
    ".zlogout": "shellscript",

    ".bashrc": "shellscript",
    ".bash_profile": "shellscript",
    ".bash_login": "shellscript",
    ".bash_logout": "shellscript",
    ".profile": "shellscript",
  },

  // ### OTHER ###
  "editor.guides.indentation": true, // vertical line guides for indentation
  "notebook.lineNumbers": "on",

  "terminal.integrated.cursorStyle": "line", // default: "block"
  "terminal.integrated.cursorBlinking": true, // default: false
  // default: "${process}", which would always be "cmdlog" (my command recorder, see .zshrc). cmdlog instead sends
  // the name of the process running inside it (zsh, python etc) as a title sequence. Falls back to the process if no title is set.
  "terminal.integrated.tabs.title": "${sequence}",
  
  "workbench.editor.empty.hint": "hidden",
  "security.workspace.trust.untrustedFiles": "open",
  "github.copilot.enable": {
    "*": false, // prevent code autocomplete suggestions
  },

}
