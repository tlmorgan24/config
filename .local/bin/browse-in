#!/bin/bash
# usage: browse-in <highlighted entry's full path>
# intended as private helper for my custom `browse` function

options=()
while [[ $# -gt 1 ]]; do
  options+=("$1")
  shift
done

path="$1"
if [[ -d "$path" ]]; then
  printf 'reload(provide-contents'
  printf ' %q' "${options[@]}"
  printf ' {1})+first+change-border-label()\n' # (clears the label, in case this ends a search - see browse-search)
fi
# if highlighted entry is not a directory, do nothing (makes no sense to navigate into a file)