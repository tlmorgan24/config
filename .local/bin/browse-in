#!/bin/bash
# Usage: `browse-in <highlighted entry's full path>`
#
# Intended as a private helper for my custom `browse` function

options=()
while [[ $# -gt 1 ]]; do
  options+=("$1")
  shift
done

path="$1"
# If the highlighted entry is not a directory, do nothing (makes no sense to navigate into a file).
if [[ -d "$path" ]]; then
  printf 'reload(provide-contents'
  printf ' %q' "${options[@]}"
  printf ' {1})+first+change-border-label()\n'  # Clear the label, in case this ends a search (see browse-search).
fi
