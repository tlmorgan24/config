#!/bin/bash
# Usage: `browse-search <highlighted entry's full path>`
#
# Intended as a private helper for my custom `browse` function. Toggle between browsing the directory in which the
# highlighted entry sits, and searching every file below it. The preview label is only shown while searching, and
# doubles as the memory of which mode is on.

options=()
while [[ $# -gt 1 ]]; do
  options+=("$1")
  shift
done

path="$1"
if [[ -z "$path" ]]; then
  exit  # Nothing highlighted (e.g. nothing matches the query), so no directory to toggle in
fi

# Get the current directory (i.e., the directory in which the highlighted entry sits), as in browse-out.
if [[ "$path" == */ && "$path" != / ]]; then
  cur="${path%/}"  # Empty-directory placeholder entry (see provide-contents)
else
  cur="${path%/*}"  # Normal entry
fi
[[ -z "$cur" ]] && cur=/

if [[ "$FZF_PREVIEW_LABEL" == " all files below "* ]]; then  # Searching, so go back to browsing.
  printf 'reload(provide-contents'
  printf ' %q' "${options[@]}"
  printf ' %q)+first+change-preview-label()\n' "$cur"
else  # Browsing, so search.
  # Set the label with the `:` form, as the last action, so a directory name containing brackets can't break it.
  printf 'reload(provide-all-contents %q)+first+change-preview-label: all files below %s \n' "$cur" "${cur/#$HOME/~}"
fi
