#!/bin/bash
# Usage: `browse-out <highlighted entry's full path>`
#
# Intended as a private helper for my custom `browse` function

options=()
while [[ $# -gt 1 ]]; do
  options+=("$1")
  shift
done

path="$1"
# Get the current directory (i.e., the directory in which the highlighted entry sits).
if [[ "$path" == */ && "$path" != / ]]; then
  cur="${path%/}"  # Empty-directory placeholder entry (see provide-contents)
else
  cur="${path%/*}"  # Normal entry
fi
[[ -z "$cur" ]] && cur=/

parent=$(dirname -- "$cur")  # Parent of current directory (to navigate to)

# For simplicity, highlight the first item of the list instead of trying to highlight the directory just exited.
printf 'reload(provide-contents'
printf ' %q' "${options[@]}"
# Clear the label, in case this ends a search (see browse-search).
printf ' %q)+first+change-preview-label()\n' "$parent"
