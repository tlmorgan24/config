#!/bin/bash
# Usage: `provide-contents [options] directory`
#
# Options are passed directly to the eza command. Dependencies: eza. For each entry in the directory, provide field 1 as
# the full path, and field 2 as the nicely formatted path. Use tabs to separate, assumption being that tabs will not
# appear in any paths. If directory is empty, print `<directory>/<TAB><NEWLINE>`, so that navigating into the directory
# is recoverable with browse-out.

options=()
while [[ $# -gt 1 ]]; do
  options+=("$1")
  shift
done

directory="$1"
if [[ ! -d "$directory" ]]; then
  echo "provide-contents: directory must be provided" >&2
  exit 1
fi

full_paths=$(
  eza "${options[@]}" -1 --no-quotes --color=never --icons=never -- "$directory" |
    while IFS= read -r line; do
      realpath -- "$directory/$line"
    done
)

pretty_paths=$(
  eza "${options[@]}" -1 --no-quotes --color=always --icons=always -- "$directory"
)

if [[ -z "$full_paths" && -z "$pretty_paths" ]]; then  # Nothing inside directory
  current_path=$(realpath -- "$directory")
  if [[ "$current_path" != / ]]; then
    current_path+=/
  fi
  printf '%s\t\n' "$current_path"
else
  # Join corresponding lines together, tab-separated.
  paste <(printf '%s\n' "$full_paths") <(printf '%s\n' "$pretty_paths")
fi
