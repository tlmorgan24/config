#!/bin/bash
# Usage: `display-contents <path>`
#
# Dependencies: eza, bat. Show the contents of <path>. If <path> is a file, print the file contents. If <path> is a
# directory, print one level of the directory's entries.

path="$1"  # Full path of highlighted entry
if [[ -f "$path" ]]; then
  bat --color=always --paging=always --decorations=never -- "$path"
elif [[ -d "$path" ]]; then
  # Display the directory's files/subfolders with eza's tree view (whose first line is the directory path itself), and
  # simplify that path, e.g. <symbols>/Users/thomas/Downloads/bar becomes <symbols>…/Downloads/bar.
  eza -1 --tree --level=1 --no-quotes --group-directories-first --color=always --icons=always -- "$path" |
    sed -E '1s|([^/]+)/(.*)/(.*)/(.*)|\1…/\3/\4|'
fi
