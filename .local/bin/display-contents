#!/bin/bash
# usage: display-contents <path>
# dependencies: eza, bat
# shows the contents of <path>. 
# If <path> is a file, prints the file contents.
# If <path> is a directory, prints one level of the directory's entries.

path="$1" # full path of highlighted entry
if [[ -f "$path" ]]; then # if path is a file, simply preview the file contents
  bat --color=always --paging=always --decorations=never -- "$path"
elif [[ -d "$path" ]]; then # if path is a directory, display its files/subfolders with eza tree view (for which first line is the directory path itself)
  eza -1 --tree --level=1 --no-quotes --group-directories-first --color=always --icons=always -- "$path" |
  sed -E '1s|([^/]+)/(.*)/(.*)/(.*)|\1…/\3/\4|' # simplify directory path, e.g. <symbols>/Users/thomas/Downloads/bar becomes <symbols>…/Downloads/bar
fi