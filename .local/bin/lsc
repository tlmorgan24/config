#!/bin/bash
# list files in a compact view, packing as many as possible on each line 
# (unlike ls and eza, which format into columns)
# usage: lsc [column width] [eza arguments],
# where 'eza arguments' will generally be a directory to list the contents of
w="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
case "${1-}" in
  ''|*[!0-9]*) ;;
  *) w="$1"; shift ;;
esac
eza -1 --color=always --icons=always "$@" | awk -v w="$w" '
  { plain=$0; gsub(/\033\[[0-9;]*m/, "", plain)
    l = length(plain) + 2
    if (len + l > w && len > 0) { print ""; len = 0 }
    printf "%s  ", $0; len += l }
  END { if (len) print "" }'