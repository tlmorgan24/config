#!/bin/sh

branch="$1" # name of fzf's highlighted branch
escaped_branch=$(echo "$branch" | gsed 's/[.[\*^$\\\/]/\\&/g') # escapes all characters special to sed's regex pattern - includes special regex characters plus the sed delimiter '/'

# we want the colour version of git log, however the colour escape codes interfere with regex, which was a pain initially.
# however, it is a blessing in disguise, because the branch is ALWAYS coloured differently to the characters either side of it.
# so, we can do the regex search for the colour sequence, followed by the branch, followed by the colour sequence.
ESC=$(printf '\033')
ANSI="${ESC}\[[0-9;]*m"

# special highlighted for selected branch in preview
if [[ "$branch" == origin/* ]]; then
  START_HIGHLIGHT="${ESC}[1;30;101m" # bold "black" text on "bright red" background
else
  START_HIGHLIGHT="${ESC}[1;30;104m" # bold "black" text on "bright blue" background
fi
END_HIGHLIGHT="${ESC}[m"

# delete all lines prior to selected branch, then substitute the branch name with its special highlight
git -c color.ui=always log --graph --all --oneline --decorate | # --decorate to explicitly display '(branch)', which is otherwise hidden when piping
  gsed -E "0,/$ANSI$escaped_branch$ANSI/{ /$ANSI$escaped_branch$ANSI/!d; }; s/$ANSI($escaped_branch)$ANSI/$START_HIGHLIGHT\1$END_HIGHLIGHT/"
  # must use 0 instead of 1, as otherwise if match is on 1st line, there are issues. This consequently requires GNU sed rather than BSD sed