#!/bin/bash
# Usage: `provide-all-contents [options] directory`
#
# Dependencies: fd. Like provide-contents, but for every file and directory below the directory (at any depth), not just
# its own entries. Field 1 is the full path, field 2 the path relative to the directory (coloured by fd), tab-separated.
# Hidden and git-ignored entries are left out (fd's defaults). If nothing is found, print `<directory>/<TAB><NEWLINE>`,
# as provide-contents does, so browse-action still knows where we are.

options=()
while [[ $# -gt 1 ]]; do
  case "$1" in
    --type)
      options+=("$1" "$2")
      shift 2
      ;;
    *)
      options+=("$1")
      shift
      ;;
  esac
done

sort_order=name
reverse=false
fd_options=()
for (( i = 0; i < ${#options[@]}; i++ )); do
  case "${options[i]}" in
    --sort=modified) sort_order=modified ;;
    --reverse) reverse=true ;;
    --type) fd_options+=("${options[i]}" "${options[i + 1]}"); ((i++)) ;;
  esac
done

directory="$1"
if [[ ! -d "$directory" ]]; then
  echo "provide-all-contents: directory must be provided" >&2
  exit 1
fi
directory=$(realpath -- "$directory")

# fd's output is streamed (rather than collected first, as in provide-contents), as there can be many entries. The full
# path is the relative path with fd's colours (and the trailing / it gives directories) removed, after the directory.
fd --color=always --base-directory "$directory" "${fd_options[@]}" |
  while IFS= read -r line; do
    if [[ "$sort_order" == modified ]]; then
      path=$(printf '%s' "$line" | sed $'s/\033\\[[0-9;]*m//g')
      timestamp=$(stat -f %m "$directory/$path" 2>/dev/null || stat -c %Y "$directory/$path")
      printf '%s\t%s\n' "$timestamp" "$line"
    else
      printf '%s\n' "$line"
    fi
  done |
  if [[ "$sort_order" == modified ]]; then
    if [[ "$reverse" == true ]]; then
      LC_ALL=C sort -rn -k1,1 -k2,2 | cut -f2-
    else
      LC_ALL=C sort -n -k1,1 -k2,2 | cut -f2-
    fi
  else
    if [[ "$reverse" == true ]]; then
      awk '{ key = $0; gsub(/\033\[[0-9;]*m/, "", key); print key "\t" $0 }' |
        LC_ALL=C sort -fr -k1,1 | cut -f2-
    else
      awk '{ key = $0; gsub(/\033\[[0-9;]*m/, "", key); print key "\t" $0 }' |
        LC_ALL=C sort -f -k1,1 | cut -f2-
    fi
  fi |
  DIRECTORY="$directory" awk '
    BEGIN { prefix = ENVIRON["DIRECTORY"]; if (prefix != "/") prefix = prefix "/" }
    {
      path = $0
      gsub(/\033\[[0-9;]*m/, "", path)
      sub(/\/$/, "", path)
      print prefix path "\t" $0
    }
    END { if (NR == 0) print prefix "\t" }
  '
