{
  "name": "line-comment-continue",
  "displayName": "Line Comment Continue",
  "description": "Continue comments on Enter",
  "publisher": "thomasmorgan",
  "version": "0.0.1",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:shellscript",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "lineCommentContinue.enter",
        "title": "Continue Line Comment"
      }
    ],
    "keybindings": [
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == go"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == shellscript"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == python"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == javascript"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == javascriptreact"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == typescript"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == typescriptreact"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == json"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == jsonc"
      }
    ]
  }
}
