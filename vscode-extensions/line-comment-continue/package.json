{
  "name": "line-comment-continue",
  "displayName": "Line Comment Continue",
  "description": "Continue comments on Enter",
  "publisher": "tlmorgan24",
  "version": "0.0.1",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:shellscript",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "scripts": {
    "test": "node --test extension.test.js"
  },
  "contributes": {
    "configuration": {
      "title": "Line Comment Continue",
      "properties": {
        "lineCommentContinue.indentSize": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "scope": "resource",
          "description": "Spaces to indent beyond the current comment text when Enter follows a colon. Existing deeper content below takes precedence."
        }
      }
    },
    "commands": [
      {
        "command": "lineCommentContinue.enter",
        "title": "Continue Line Comment"
      },
      {
        "command": "lineCommentContinue.backspace",
        "title": "Remove Line Comment Bullet"
      }
    ],
    "keybindings": [
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == go"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == shellscript"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == python"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == javascript"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == javascriptreact"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == typescript"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == typescriptreact"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == json"
      },
      {
        "command": "lineCommentContinue.enter",
        "key": "enter",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == jsonc"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == go"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == shellscript"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == python"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == javascript"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == javascriptreact"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == typescript"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == typescriptreact"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == json"
      },
      {
        "command": "lineCommentContinue.backspace",
        "key": "backspace",
        "when": "editorTextFocus && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && editorLangId == jsonc"
      }
    ]
  }
}
