theme = catppuccin-mocha.conf
font-size = 16
font-family = JetBrainsMono Nerd Font

minimum-contrast = 1

mouse-hide-while-typing = true
window-decoration = true
window-theme = ghostty

macos-option-as-alt = true
macos-titlebar-style = tabs

window-padding-x=12
window-padding-y=12
window-padding-balance=true

cursor-click-to-move = true

## keybindings for shortcuts whose key sequences are intercepted by Ghostty ##

# intention: copy command-line program's current selection to clipboard (would use cmd+c, but Ghostty already uses this to copy it's OWN selection, e.g. following mouse drag)
# cmd+shift+c would technically be 10u (9u is for cmd+c), but I still expect programs to expect cmd+c, hence use of 9u here
keybind = cmd+shift+c=text:\x1b[99;9u 

# intention: cut command-line program's current selection to clipboard
keybind = cmd+x=text:\x1b[120;9u

# intention: undo edit to command-line
keybind = cmd+z=text:\x1f

# intention: redo edit to command-line
keybind = cmd+shift+z=text:\x1b/