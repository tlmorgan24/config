theme = catppuccin-mocha.conf
font-size = 16
font-family = JetBrainsMono Nerd Font

minimum-contrast = 1

mouse-hide-while-typing = true
window-decoration = true
window-theme = ghostty

macos-option-as-alt = true
macos-titlebar-style = tabs

window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

cursor-click-to-move = true
# Line cursor by default, as in VS Code. The shell integration shows a line at the prompt anyway, but resets to this
# default before each command, so without it programs that don't set a shape (e.g. Claude Code) get a block.
cursor-style = bar

# Keybindings for shortcuts whose key sequences are intercepted by Ghostty
keybind = cmd+up=text:\x1b[1;9A
keybind = cmd+down=text:\x1b[1;9B
keybind = cmd+shift+up=text:\x1b[1;10A
keybind = cmd+shift+down=text:\x1b[1;10B
# Override Ghostty default of cmd+enter meaning "toggle fullscreen" (cmd+ctrl+f still does that), for my zsh queue.
keybind = cmd+enter=text:\x1b[13;9u
# Open the prompt in $EDITOR, in Claude Code (see .claude/keybindings.json) and zsh (see .zshrc).
keybind = cmd+e=text:\x1b[101;9u
# Save and quit, in Vim (see .vimrc).
keybind = cmd+s=text:\x1b[115;9u

# Intention: copy command-line program's current selection to clipboard (would use cmd+c, but Ghostty already uses this
# to copy its OWN selection, e.g. following mouse drag). cmd+shift+c would technically be 10u (9u is for cmd+c), but I
# still expect programs to expect cmd+c, hence use of 9u here.
keybind = cmd+shift+c=text:\x1b[99;9u
keybind = cmd+x=text:\x1b[120;9u

keybind = cmd+z=text:\x1f
keybind = cmd+shift+z=text:\x1b/

# Override Ghostty default of cmd+]/[ meaning "go to next/previous split" (cmd+alt+arrows still navigate splits).
keybind = cmd+]=text:\x1b[93;9u
keybind = cmd+[=text:\x1b[91;9u

# Jump to the previous/next command's prompt, e.g. to get back past a long output (Ghostty's defaults for this,
# cmd+up/down and cmd+shift+up/down, are used above). Needs macOS's own ctrl+up/down turned off, which copy.sh does.
keybind = ctrl+up=jump_to_prompt:-1
keybind = ctrl+down=jump_to_prompt:1
